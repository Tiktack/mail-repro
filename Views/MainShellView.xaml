<Page
    x:Class="MailPageRepro.Views.MainShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MailPageRepro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:uc="using:MailPageRepro.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="MainTitleBar"
            Title="Mail Repro"
            BackRequested="MainTitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind AppShell.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="MainTitleBar_PaneToggleRequested"
            Subtitle="Alpha">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/StoreLogo.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <toolkit:Segmented
                        x:Name="ViewModeSegmented"
                        SelectedIndex="0"
                        SelectionChanged="ViewModeSegmented_SelectionChanged">
                        <toolkit:SegmentedItem
                            x:Uid="MainShell_MailSegment"
                            Icon="{ui:FontIcon Glyph=&#xE715;}"
                            Tag="mail" />
                        <toolkit:SegmentedItem
                            x:Uid="MainShell_CalendarSegment"
                            Icon="{ui:FontIcon Glyph=&#xE787;}"
                            Tag="calendar" />
                    </toolkit:Segmented>

                    <uc:StatusControl ViewModel="{x:Bind SyncStatusViewModel, Mode=OneTime}" />

                    <Button
                        x:Name="SettingsButton"
                        x:Uid="MainShell_SettingsButton"
                        Click="SettingsButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <AnimatedIcon Width="17" Height="17">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <Frame
            x:Name="AppShell"
            Grid.Row="1"
            Navigating="AppShell_Navigating" />
    </Grid>
</Page>
