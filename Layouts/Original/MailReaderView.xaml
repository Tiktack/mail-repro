<UserControl
    x:Class="MailPageRepro.Views.Mail.MailReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MailPageRepro.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MailPageRepro.Helpers"
    xmlns:local="using:MailPageRepro.Views.Mail"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MailPageRepro.ViewModels.Mail"
    Loaded="MailReaderView_Loaded"
    SizeChanged="MailReaderView_SizeChanged"
    Unloaded="MailReaderView_Unloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--
            Quiet inline button for recipient names in the "To/Cc/Bcc" line.
            BasedOn keeps the default template/visual states — a bare Style would wipe them.
        -->
        <Style
            x:Key="ReaderInlineLinkButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style
            x:Key="ReaderSubtleIconButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>

        <!--  Shared contact flyout; populated via ViewModel.PrepareContactFlyoutAsync before ShowAt  -->
        <Flyout x:Name="ContactFlyout" Placement="BottomEdgeAlignedLeft">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ContactAvatar
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.FlyoutContactName, Mode=OneWay}"
                    FontSize="16"
                    Icon="{x:Bind ViewModel.FlyoutContactIcon, Mode=OneWay}"
                    Initials="{x:Bind ViewModel.FlyoutContactInitials, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="1"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.FlyoutContactName, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.FlyoutContactEmail, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.FlyoutHasEmail, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Flyout>

        <!--  "+N more" recipients flyout: every recipient of the message, with kind  -->
        <Flyout x:Name="RecipientsOverflowFlyout" Placement="BottomEdgeAlignedLeft">
            <ItemsControl MaxWidth="360" ItemsSource="{x:Bind ViewModel.AllRecipients, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReaderOverflowRecipient">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:ContactAvatar
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Initials="{x:Bind Initials, Mode=OneTime}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Email, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ShowEmail, Mode=OneTime}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind KindLabel, Mode=OneTime}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Flyout>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <!--  Email header: subject / divider / sender + actions  -->
        <Grid
            Grid.Row="0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Subject + date  -->
            <Grid
                Grid.Row="0"
                Padding="16,8,16,8"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subject, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FormattedDate, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FullDate, Mode=OneWay}" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Sender + recipients + actions  -->
            <Grid
                Grid.Row="2"
                Padding="16,6,10,8"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:ContactAvatar
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.SenderDisplayName, Mode=OneWay}"
                    FontSize="16"
                    Icon="{x:Bind ViewModel.SenderIcon, Mode=OneWay}"
                    Initials="{x:Bind ViewModel.SenderInitials, Mode=OneWay}" />

                <!--  Name + email + unsubscribe, then the inline recipient line  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <!--  Reserve the unsubscribe button's height before body metadata arrives.  -->
                    <Grid MinHeight="24" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SenderNameColumn" Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SenderDisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="SenderEmailText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SenderEmail, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ViewModel.ShowSenderEmail, Mode=OneWay}" />
                        <controls:UnsubscribeButton
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            UnsubscribeAction="{x:Bind ViewModel.UnsubscribeAction, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsUnsubscribeAvailable, Mode=OneWay}" />
                    </Grid>

                    <!--
                        Single-line recipients: the panel shows as many chips as the width fits
                        (the rest collapse behind "+N more", count updated from code-behind via
                        HiddenCountChanged since it's a layout result, not VM state). The
                        left-aligned grid keeps "+N more" hugging the last visible chip.
                    -->
                    <Grid
                        HorizontalAlignment="Left"
                        ColumnSpacing="2"
                        Visibility="{x:Bind ViewModel.HasRecipients, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecipientChips, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SingleLineFitPanel
                                        Loaded="RecipientsPanel_Loaded"
                                        Spacing="2"
                                        Unloaded="RecipientsPanel_Unloaded" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReaderRecipientChip">
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind LeadingText, Mode=OneTime}"
                                            Visibility="{x:Bind HasLeadingText, Mode=OneTime}" />
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="{x:Bind DisplayName, Mode=OneTime}"
                                            Click="RecipientChip_Click"
                                            Style="{StaticResource ReaderInlineLinkButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneTime}">
                                            <!--
                                                NoWrap is meaningful: the caption style inherits Wrap,
                                                which would beat the trimming and grow the line.
                                            -->
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ButtonText, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            x:Name="RecipientsMoreButton"
                            x:Uid="MailReader_ShowAllRecipients"
                            Grid.Column="1"
                            Click="RecipientsOverflow_Click"
                            Style="{StaticResource ReaderInlineLinkButtonStyle}"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="RecipientsMoreText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="NoWrap" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!--  Icon-only actions (the narrow state folds the low-priority ones into overflow)  -->
                <CommandBar
                    x:Name="ActionsBar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="False"
                    IsOpen="False">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            x:Uid="MailReader_Reply"
                            Width="Auto"
                            MinWidth="40"
                            AutomationProperties.AutomationId="ReaderReplyButton">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8CA;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ReplyAllButton"
                            x:Uid="MailReader_ReplyAll"
                            Width="Auto"
                            MinWidth="40"
                            AutomationProperties.AutomationId="ReaderReplyAllButton">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C2;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ForwardButton"
                            x:Uid="MailReader_Forward"
                            Width="Auto"
                            MinWidth="40"
                            AutomationProperties.AutomationId="ReaderForwardButton">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE89C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator x:Name="ActionsSeparator" />
                        <AppBarButton
                            x:Uid="MailReader_Delete"
                            Width="Auto"
                            MinWidth="40"
                            AutomationProperties.AutomationId="ReaderDeleteButton"
                            Command="{x:Bind ViewModel.DeleteCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="DarkModeToggle"
                            x:Uid="MailReader_DarkMode"
                            Width="Auto"
                            MinWidth="40"
                            AutomationProperties.AutomationId="ReaderDarkModeToggle"
                            Command="{x:Bind ViewModel.ToggleReaderThemeCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="{x:Bind local:MailReaderView.ThemeGlyph(ViewModel.IsReaderDark), Mode=OneWay}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Uid="MailReader_Star" Command="{x:Bind ViewModel.ToggleStarCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE734;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="MailReader_MarkUnread" Command="{x:Bind ViewModel.MarkUnreadCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C3;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>
        </Grid>

        <!--  Email content + attachment strip  -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6">
                    <!--  Loading State  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock x:Uid="MailReader_Loading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!--  Body unavailable state  -->
                    <StackPanel
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasBodyError, Mode=OneWay}">
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE783;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BodyErrorMessage, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Uid="MailReader_RetryBody"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.RetryLoadBodyCommand}"
                            Visibility="{x:Bind ViewModel.CanRetryBody, Mode=OneWay}" />
                    </StackPanel>

                    <!--  WebView Container  -->
                    <Grid
                        x:Name="WebviewGrid"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.IsBodyVisible, Mode=OneWay}" />
                </Grid>

                <!--  Attachments (below divider, like the body footer)  -->
                <StackPanel Grid.Row="1" Visibility="{x:Bind local:MailReaderView.AttachmentsVisibility(ViewModel.Attachments), Mode=OneWay}">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="16,10,16,12">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReaderAttachmentItem">
                                        <Grid
                                            Padding="10,8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            ColumnSpacing="10"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                Glyph="{x:Bind IconGlyph, Mode=OneTime}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    MaxWidth="180"
                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind SizeDisplay, Mode=OneTime}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="MailReader_SaveAttachment"
                                                Grid.Column="2"
                                                Command="{x:Bind SaveCommand}"
                                                CommandParameter="{x:Bind Info, Mode=OneTime}"
                                                Style="{StaticResource ReaderSubtleIconButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xE896;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderWidthStates">
                <VisualState x:Name="WideHeader" />
                <VisualState x:Name="NarrowHeader">
                    <VisualState.Setters>
                        <Setter Target="SenderEmailText.Visibility" Value="Collapsed" />
                        <Setter Target="SenderNameColumn.MaxWidth" Value="220" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
