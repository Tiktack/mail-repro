<Page
    x:Class="MailPageRepro.Views.Mail.MailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MailPageRepro.Helpers"
    xmlns:local="using:MailPageRepro.Views.Mail"
    xmlns:maillist="using:MailPageRepro.Controls.MailList"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rayControls="using:MailPageRepro.Controls"
    xmlns:viewmodels="using:MailPageRepro.ViewModels.Mail"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:MailViewTabs x:Key="MailViewTabs">MailReader</local:MailViewTabs>

        <!--  One rounding for every nav row (accounts, folders, All Inboxes); one step rounder than OverlayCornerRadius.  -->
        <CornerRadius x:Key="MailNavItemCornerRadius">9</CornerRadius>

        <DataTemplate x:Key="AccountNavigationTemplate" x:DataType="viewmodels:AccountNavigationItemViewModel">
            <NavigationViewItem
                AutomationProperties.Name="{x:Bind ToolTipText, Mode=OneWay}"
                CornerRadius="{StaticResource MailNavItemCornerRadius}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                MenuItemsSource="{x:Bind Children, Mode=OneWay}"
                SelectsOnInvoked="{x:Bind IsSelectable, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="{x:Bind helpers:BindingExtensions.ToImageSource(PictureUrl), Mode=OneWay}" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.Content>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Email, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </NavigationViewItem.Content>
            </NavigationViewItem>
        </DataTemplate>

        <DataTemplate x:Key="FolderNavigationTemplate" x:DataType="viewmodels:FolderNavigationItemViewModel">
            <NavigationViewItem
                AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                helpers:FolderContextMenu.ItemsSource="{x:Bind ContextMenuItems, Mode=OneWay}"
                CornerRadius="{StaticResource MailNavItemCornerRadius}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                MenuItemsSource="{x:Bind Children, Mode=OneWay}"
                SelectsOnInvoked="{x:Bind IsSelectable, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                <NavigationViewItem.Resources>
                    <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">16</x:Double>
                    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">32</x:Double>
                    <Thickness x:Key="NavigationViewItemButtonMargin">4,0,4,1</Thickness>
                </NavigationViewItem.Resources>
                <NavigationViewItem.Icon>
                    <FontIcon
                        helpers:FolderColorBrush.Hex="{x:Bind Color, Mode=OneWay}"
                        FontSize="16"
                        Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.Content>
                    <TextBlock
                        VerticalAlignment="Center"
                        helpers:FolderColorBrush.Hex="{x:Bind Color, Mode=OneWay}"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </NavigationViewItem.Content>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge
                        Visibility="{x:Bind helpers:BindingExtensions.CountToVisibility(UnreadCount), Mode=OneWay}"
                        Value="{x:Bind UnreadCount, Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </DataTemplate>

        <DataTemplate x:Key="UnifiedInboxNavigationTemplate" x:DataType="viewmodels:UnifiedInboxNavigationItemViewModel">
            <NavigationViewItem
                AutomationProperties.AutomationId="UnifiedInboxNavItem"
                AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                CornerRadius="{StaticResource MailNavItemCornerRadius}"
                SelectsOnInvoked="{x:Bind IsSelectable, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon FontSize="16" Glyph="{x:Bind IconGlyph, Mode=OneTime}" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.Content>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </NavigationViewItem.Content>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge
                        Visibility="{x:Bind helpers:BindingExtensions.CountToVisibility(UnreadCount), Mode=OneWay}"
                        Value="{x:Bind UnreadCount, Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </DataTemplate>

        <local:NavigationItemTemplateSelector
            x:Key="NavigationItemTemplateSelector"
            AccountTemplate="{StaticResource AccountNavigationTemplate}"
            FolderTemplate="{StaticResource FolderNavigationTemplate}"
            UnifiedInboxTemplate="{StaticResource UnifiedInboxNavigationTemplate}" />
    </Page.Resources>

    <Grid>
        <NavigationView
            x:Name="AccountsNavigationView"
            x:Uid="MailView_AccountsNavigation"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="{x:Bind Settings.State.IsNavigationPaneOpen, Mode=TwoWay, FallbackValue=False}"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemTemplateSelector="{StaticResource NavigationItemTemplateSelector}"
            MenuItemsSource="{x:Bind ViewModel.NavigationItems, Mode=OneWay}"
            PaneDisplayMode="Auto"
            SelectedItem="{x:Bind ViewModel.SelectedNavigationItem, Mode=TwoWay}"
            SelectionChanged="AccountsNavigationView_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.PaneCustomContent>
                <StackPanel Padding="4" Spacing="4">
                    <Button
                        x:Uid="MailView_NewMailButton"
                        Height="40"
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.AutomationId="NewMailButton"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="&#xECC8;" />
                            <TextBlock
                                x:Uid="MailView_NewMailText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Visibility="{x:Bind helpers:BindingExtensions.ToVisibility(AccountsNavigationView.IsPaneOpen), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!--  Divider  -->
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <!--  Content Area: Email List + Frame  -->
            <Grid Margin="0,0,8,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MailListColumn" Width="400" />
                    <!--
                        Floor below which the reader becomes unusable; past it the grid clips
                        at the window edge instead of squeezing the reader further.
                    -->
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <controls:PropertySizer
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Binding="{x:Bind AccountsNavigationView.OpenPaneLength, Mode=TwoWay}"
                    Canvas.ZIndex="20"
                    Minimum="200"
                    Opacity="0" />

                <!--
                    Sits in the ColumnSpacing gap (not over the list scrollbar or reader edge);
                    width persists via SettingsService through the MailListWidth property.
                -->
                <controls:PropertySizer
                    x:Name="MailListSizer"
                    Grid.Column="1"
                    Width="8"
                    Margin="-8,0,0,0"
                    HorizontalAlignment="Left"
                    Binding="{x:Bind MailListWidth, Mode=TwoWay}"
                    Canvas.ZIndex="20"
                    Maximum="800"
                    Minimum="280"
                    Opacity="0" />

                <!--  Email List  -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Filter Bar: category segments + unread filter  -->
                        <Grid
                            Grid.Row="0"
                            Padding="8,8,8,4"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer
                                Grid.Column="0"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <rayControls:AnimatedSegmented
                                    HorizontalAlignment="Left"
                                    ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSegment, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.ShowSegments, Mode=OneWay}" />
                            </ScrollViewer>

                            <Button
                                x:Uid="MailView_FiltersButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Top"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon
                                    x:Name="FilterIcon"
                                    FontSize="14"
                                    Glyph="&#xE71C;" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <RadioMenuFlyoutItem
                                            x:Uid="MailView_FilterAll"
                                            Click="ReadFilter_Click"
                                            GroupName="ReadFilter"
                                            IsChecked="{x:Bind IsReadFilter(ViewModel.ReadFilter, 'All'), Mode=OneWay}"
                                            Tag="All" />
                                        <RadioMenuFlyoutItem
                                            x:Uid="MailView_FilterUnread"
                                            Click="ReadFilter_Click"
                                            GroupName="ReadFilter"
                                            IsChecked="{x:Bind IsReadFilter(ViewModel.ReadFilter, 'Unread'), Mode=OneWay}"
                                            Tag="Unread" />
                                        <RadioMenuFlyoutItem
                                            x:Uid="MailView_FilterRead"
                                            Click="ReadFilter_Click"
                                            GroupName="ReadFilter"
                                            IsChecked="{x:Bind IsReadFilter(ViewModel.ReadFilter, 'Read'), Mode=OneWay}"
                                            Tag="Read" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!--  Empty State  -->
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                            <FontIcon
                                FontSize="48"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE715;" />
                            <TextBlock
                                x:Uid="MailView_EmptyState"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!--  Mail List  -->
                        <maillist:MailListControl
                            x:Name="MailList"
                            Grid.Row="1"
                            DeleteCommand="{x:Bind ViewModel.DeleteCommand}"
                            SelectedItem="{x:Bind ViewModel.SelectedMailItem, Mode=TwoWay}"
                            Source="{x:Bind ViewModel.EmailSource, Mode=OneWay}"
                            ToggleReadCommand="{x:Bind ViewModel.ToggleReadCommand}"
                            ToggleStarCommand="{x:Bind ViewModel.ToggleStarCommand}"
                            Visibility="{x:Bind ViewModel.ShowEmailList, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!--  Email Reader / Composer Frame  -->
                <Grid Grid.Column="1">
                    <controls:SwitchPresenter TargetType="local:MailViewTabs" Value="{x:Bind ViewModel.CurrentTabType, Mode=OneWay}">
                        <controls:Case Value="MailReader">
                            <!--  The reader's XAML (flyouts, command bar, repeater template) is large, so it is
                                  created on first use instead of during the startup layout pass.  -->
                            <ContentControl
                                x:Name="ReaderHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </controls:Case>

                        <controls:Case Value="MailComposer">
                            <TextBlock
                                x:Uid="MailView_ComposerPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:Case>

                        <controls:Case Value="None">
                            <TextBlock
                                x:Uid="MailView_SelectEmailPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:Case>
                    </controls:SwitchPresenter>
                </Grid>
            </Grid>
        </NavigationView>

        <!--  Transient feedback for failed mail actions (local state is reverted before this opens)  -->
        <InfoBar
            MaxWidth="480"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Canvas.ZIndex="100"
            IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="Warning" />
        <VisualStateManager.VisualStateGroups>
            <!--  Visual-only mapping of the read filter state: accent the filter icon when active  -->
            <VisualStateGroup x:Name="ReadFilterStates">
                <VisualState x:Name="ReadFilterInactive" />
                <VisualState x:Name="ReadFilterActive">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsReadFilterActive, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FilterIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
