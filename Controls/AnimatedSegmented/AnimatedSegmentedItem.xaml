<UserControl
    x:Class="MailPageRepro.Controls.AnimatedSegmentedItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The default Button template costs ~11 MB per instance (measured), so the pill
        supplies a minimal template and renders its own hover/pressed/selected visuals.
        Hover/selected backgrounds are resolved in code-behind, NOT via {ThemeResource}:
        referencing theme brushes that nothing else in the loaded UI uses makes the
        first minimize/restore materialize an unused theme-dictionary branch (~64 MB,
        measured). The BrushTransition in the template animates the color changes.
        Text/Glyph/ToolTip are set from code-behind: x:Bind would only deliver values
        on Loading, which is too late for the initial selection measure.
    -->
    <Button
        x:Name="PillButton"
        Height="32"
        MinWidth="0"
        Padding="0"
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        Click="PillButton_Click"
        CornerRadius="10"
        PointerCanceled="PillButton_PointerExited"
        PointerEntered="PillButton_PointerEntered"
        PointerExited="PillButton_PointerExited">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.3" />
                    </Border.BackgroundTransition>
                    <ContentPresenter />
                </Border>
            </ControlTemplate>
        </Button.Template>

        <!--
            8 + 16 + 8 = a perfect 32x32 circle when only the icon shows.
            The panel stretches to the pill's full height so icon and label center
            against integral 32px geometry — centering against the panel's own
            label-driven fractional height shifts the icon off-center after
            per-element layout rounding.
        -->
        <StackPanel Margin="8,0" Orientation="Horizontal">
            <!--  Fixed 16px box keeps icons optically centered; two stacked icons
                  cross-fade instead of animating brush colors  -->
            <Grid
                Width="16"
                Height="16"
                VerticalAlignment="Center">
                <FontIcon
                    x:Name="RestIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <FontIcon
                    x:Name="SelectedIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Opacity="0" />
            </Grid>
            <!--  Width-animated host; TextTrimming=Clip reveals the label as the pill grows  -->
            <Grid x:Name="TextHost" MaxWidth="0">
                <TextBlock
                    x:Name="Label"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Opacity="0"
                    TextTrimming="Clip"
                    TextWrapping="NoWrap" />
            </Grid>
        </StackPanel>
    </Button>
</UserControl>
