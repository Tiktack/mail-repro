<UserControl
    x:Class="MailPageRepro.Controls.UnsubscribeButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Idle glyph shrinks/fades while the progress ring takes over (CopyButton's outgoing
              splines); holds until the action completes and ResultAnimation runs.  -->
        <Storyboard x:Name="WorkingAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadyGlyph" Storyboard.TargetProperty="(UIElement.Opacity)">
                <SplineDoubleKeyFrame
                    KeySpline="0.33,0.0 0.67,1.0"
                    KeyTime="0:0:0.133"
                    Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadyScale" Storyboard.TargetProperty="(ScaleX)">
                <SplineDoubleKeyFrame
                    KeySpline="0.13,0.0 0.0,1.0"
                    KeyTime="0:0:0.133"
                    Value="0.273" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadyScale" Storyboard.TargetProperty="(ScaleY)">
                <SplineDoubleKeyFrame
                    KeySpline="0.13,0.0 0.0,1.0"
                    KeyTime="0:0:0.133"
                    Value="0.273" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WorkingRing" Storyboard.TargetProperty="(UIElement.Opacity)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.067" Value="0.0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.33,0.0 0.67,1.0"
                    KeyTime="0:0:0.2"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--  The CopyButton success arc, retimed to start from the working state: ring out, result
              glyph pops with overshoot, holds ~1s, fades, and the idle glyph settles back in.  -->
        <Storyboard x:Name="ResultAnimation" Completed="ResultAnimation_Completed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WorkingRing" Storyboard.TargetProperty="(UIElement.Opacity)">
                <SplineDoubleKeyFrame
                    KeySpline="0.33,0.0 0.67,1.0"
                    KeyTime="0:0:0.1"
                    Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadyGlyph" Storyboard.TargetProperty="(UIElement.Opacity)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.3" Value="0.0" />
                <SplineDoubleKeyFrame
                    KeySpline="1.0,0.0 1.0,1.0"
                    KeyTime="0:0:1.433"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadyScale" Storyboard.TargetProperty="(ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.273" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.167" Value="0.273" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadyScale" Storyboard.TargetProperty="(ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.273" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.167" Value="0.273" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultHost" Storyboard.TargetProperty="(UIElement.Opacity)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.133" Value="0.0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.33,0.0 0.67,1.0"
                    KeyTime="0:0:0.267"
                    Value="1.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.167" Value="1.0" />
                <SplineDoubleKeyFrame
                    KeySpline="1.0,0.0 0.98,1.0"
                    KeyTime="0:0:1.3"
                    Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultScale" Storyboard.TargetProperty="(ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.133" Value="0.385" />
                <SplineDoubleKeyFrame
                    KeySpline="0.39,0.0 0.63,1.0"
                    KeyTime="0:0:0.267"
                    Value="1.146" />
                <SplineDoubleKeyFrame
                    KeySpline="0.55,0.0 0.02,1.0"
                    KeyTime="0:0:0.333"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultScale" Storyboard.TargetProperty="(ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.133" Value="0.385" />
                <SplineDoubleKeyFrame
                    KeySpline="0.39,0.0 0.63,1.0"
                    KeyTime="0:0:0.267"
                    Value="1.146" />
                <SplineDoubleKeyFrame
                    KeySpline="0.55,0.0 0.02,1.0"
                    KeyTime="0:0:0.333"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Button
        x:Name="HostButton"
        x:Uid="UnsubscribeButton"
        Width="24"
        Height="24"
        Padding="0"
        AutomationProperties.AutomationId="ReaderUnsubscribeButton"
        Background="Transparent"
        BorderBrush="Transparent"
        Click="HostButton_Click"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
        <Grid>
            <FontIcon
                x:Name="ReadyGlyph"
                FontSize="12"
                Glyph="&#xE71B;"
                RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <ScaleTransform x:Name="ReadyScale" />
                </FontIcon.RenderTransform>
            </FontIcon>

            <ProgressRing
                x:Name="WorkingRing"
                Width="12"
                Height="12"
                MinWidth="12"
                MinHeight="12"
                IsActive="False"
                Opacity="0"
                Visibility="Collapsed" />

            <!--  One animated host for both outcomes; code toggles which icon shows before the pop  -->
            <Grid
                x:Name="ResultHost"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ResultScale" />
                </Grid.RenderTransform>
                <FontIcon
                    x:Name="SuccessIcon"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;" />
                <FontIcon
                    x:Name="FailureIcon"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE783;"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Button>
</UserControl>
