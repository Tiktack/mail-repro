<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MailPageRepro.Controls.MailList.MailListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:MailPageRepro.Controls"
    xmlns:helpers="using:MailPageRepro.Helpers"
    xmlns:local="using:MailPageRepro.Controls.MailList"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  Shared context menu for email rows; Opening flips labels off the target row's state  -->
            <MenuFlyout x:Key="MailItemContextFlyout" Opening="MailItemContextFlyout_Opening">
                <MenuFlyoutItem x:Uid="MailList_ToggleRead" Click="ToggleReadFlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C3;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MailList_ToggleStar" Click="ToggleStarFlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MailList_Delete" Click="DeleteFlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

        <!--  Date Header Template  -->
        <DataTemplate x:Key="DateHeaderTemplate" x:DataType="local:MailListDateHeader">
            <Grid Margin="0,12,0,0" Padding="4,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind DisplayText, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind EmailCount, Mode=OneWay}" />
                <!--  Divider  -->
                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Height="1"
                    Margin="0,8,0,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>
        </DataTemplate>

        <!--  Single Email Template  -->
        <DataTemplate x:Key="EmailTemplate" x:DataType="local:MailListSingleEmail">
            <Grid Padding="0,8" Background="Transparent" ContextFlyout="{StaticResource MailItemContextFlyout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Contact icon. Kept out of the text grid so its fixed height can't inflate the sender/subject rows (e.g. a missing star icon would otherwise spill into the sender row).  -->
                <controls:ContactAvatar
                    Width="36"
                    Height="36"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind SenderDisplay, Mode=OneWay}"
                    FontSize="15"
                    Icon="{x:Bind ContactIcon, Mode=OneWay}"
                    Initials="{x:Bind SenderInitials, Mode=OneWay}" />

                <!--  Text content: rows size purely to their text, independent of the avatar  -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Sender + Time  -->
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind SenderDisplay, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind TimeDisplay, Mode=OneTime}" />

                    <!--  Subject (unread accent / read primary overlay) + Indicators  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontSize="14"
                        FontWeight="{x:Bind helpers:BindingExtensions.ToUnreadFontWeight(IsRead), Mode=OneWay}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind Subject, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:BindingExtensions.ToInverseVisibility(IsRead), Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontSize="14"
                        FontWeight="{x:Bind helpers:BindingExtensions.ToUnreadFontWeight(IsRead), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Subject, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:BindingExtensions.ToVisibility(IsRead), Mode=OneWay}" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,2,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE723;"
                            Visibility="{x:Bind HasAttachments, Mode=OneTime}" />
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE735;"
                            Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Preview  -->
                    <Grid
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind PreviewText, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            MaxWidth="140"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind AccountLabel, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind AccountLabel, Mode=OneTime}"
                            Visibility="{x:Bind HasAccountLabel, Mode=OneTime}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!--  Thread Header Template  -->
        <DataTemplate x:Key="ThreadHeaderTemplate" x:DataType="local:MailListThreadItem">
            <Grid Padding="4,8" Background="Transparent" ContextFlyout="{StaticResource MailItemContextFlyout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Expand/Collapse Chevron (right->down like TreeView)  -->
                <Button
                    Grid.Row="2"
                    Width="20"
                    Height="20"
                    Margin="0,2,10,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ExpandThread_Click"
                    Tag="{x:Bind}">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind local:MailListControl.ChevronGlyph(IsExpanded), Mode=OneWay}" />
                </Button>

                <!--  Contact icon  -->
                <controls:ContactAvatar
                    Grid.RowSpan="2"
                    Width="36"
                    Height="36"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind SenderDisplay, Mode=OneWay}"
                    FontSize="15"
                    Icon="{x:Bind ContactIcon, Mode=OneWay}"
                    Initials="{x:Bind SenderInitials, Mode=OneWay}" />

                <!--  Sender + InfoBadge + Time  -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind SenderDisplay, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <InfoBadge
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Value="{x:Bind ThreadCount, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind TimeDisplay, Mode=OneTime}" />
                </Grid>

                <!--  Subject + Indicators  -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="14"
                        FontWeight="{x:Bind helpers:BindingExtensions.ToUnreadFontWeight(IsRead), Mode=OneWay}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind Subject, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:BindingExtensions.ToInverseVisibility(IsRead), Mode=OneWay}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="14"
                        FontWeight="{x:Bind helpers:BindingExtensions.ToUnreadFontWeight(IsRead), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Subject, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:BindingExtensions.ToVisibility(IsRead), Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Orientation="Horizontal"
                        Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE723;"
                            Visibility="{x:Bind HasAttachments, Mode=OneTime}" />
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE735;"
                            Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!--  Preview  -->
                <Grid
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind PreviewText, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        MaxWidth="140"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind AccountLabel, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind AccountLabel, Mode=OneTime}"
                        Visibility="{x:Bind HasAccountLabel, Mode=OneTime}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--  Thread Child Template  -->
        <DataTemplate x:Key="ThreadChildTemplate" x:DataType="local:MailListThreadChild">
            <Grid Padding="4,8" Background="Transparent" ContextFlyout="{StaticResource MailItemContextFlyout}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Spacer to align with chevron  -->
                <Border Grid.RowSpan="2" Width="24" />

                <!--  Vertical line indicator  -->
                <Border
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="2"
                    Margin="17,0,8,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Sender + Indicators + Time  -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind SenderDisplay, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE723;"
                            Visibility="{x:Bind HasAttachments, Mode=OneTime}" />
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE735;"
                            Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind TimeDisplay, Mode=OneTime}" />
                    </StackPanel>
                </Grid>

                <!--  Subject (unread accent / read primary overlay)  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,2,0,0"
                    FontSize="11"
                    FontWeight="{x:Bind helpers:BindingExtensions.ToUnreadFontWeight(IsRead), Mode=OneWay}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind Subject, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind helpers:BindingExtensions.ToInverseVisibility(IsRead), Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,2,0,0"
                    FontSize="11"
                    FontWeight="{x:Bind helpers:BindingExtensions.ToUnreadFontWeight(IsRead), Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind Subject, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind helpers:BindingExtensions.ToVisibility(IsRead), Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!--  Template Selector  -->
            <local:MailListTemplateSelector
                x:Key="MailListTemplateSelector"
                DateHeaderTemplate="{StaticResource DateHeaderTemplate}"
                EmailTemplate="{StaticResource EmailTemplate}"
                ThreadChildTemplate="{StaticResource ThreadChildTemplate}"
                ThreadHeaderTemplate="{StaticResource ThreadHeaderTemplate}" />
        </ResourceDictionary>

    </UserControl.Resources>

    <ListView
        x:Name="MailListView"
        Padding="0"
        ContainerContentChanging="MailListView_ContainerContentChanging"
        IsItemClickEnabled="False"
        ItemTemplateSelector="{StaticResource MailListTemplateSelector}"
        SelectionChanged="MailListView_SelectionChanged"
        SelectionMode="Single">
        <!--  Render the initial page immediately; animate later collection changes from sync/actions.  -->
        <ListView.ItemContainerTransitions>
            <TransitionCollection>
                <AddDeleteThemeTransition />
                <ContentThemeTransition />
                <ReorderThemeTransition />
            </TransitionCollection>
        </ListView.ItemContainerTransitions>
        <ListView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsStackPanel CacheLength="2" />
            </ItemsPanelTemplate>
        </ListView.ItemsPanel>
    </ListView>
</UserControl>
