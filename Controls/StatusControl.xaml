<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MailPageRepro.Controls.StatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:MailPageRepro.Extensions"
    xmlns:helpers="using:MailPageRepro.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:MailPageRepro.ViewModels"
    mc:Ignorable="d">

    <Button
        x:Uid="StatusControl_Button"
        Padding="0"
        CornerRadius="16"
        Style="{ThemeResource SubtleButtonStyle}">
        <Button.Content>
            <Grid>
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}" />
                <FontIcon FontSize="14" Glyph="&#xE794;" />
            </Grid>
        </Button.Content>
        <Button.Flyout>
            <Flyout x:Name="StatusFlyout">
                <Grid
                    MinWidth="360"
                    MaxWidth="420"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="StatusControl_Title"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <toolkit:SettingsCard
                        x:Uid="StatusControl_NoAccountsCard"
                        Grid.Row="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}"
                        Visibility="{x:Bind helpers:BindingExtensions.ToInverseVisibility(ViewModel.HasAccounts), Mode=OneWay}">
                        <toolkit:SettingsCard.Resources>
                            <Thickness x:Key="SettingsCardHeaderIconMargin">2,0,12,0</Thickness>
                            <x:Double x:Key="SettingsCardWrapThreshold">286</x:Double>
                            <x:Double x:Key="SettingsCardContentMinWidth">0</x:Double>
                        </toolkit:SettingsCard.Resources>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE910;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button
                            x:Uid="StatusControl_AddButton"
                            Click="AddAccountButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    </toolkit:SettingsCard>
                    <ItemsRepeater
                        Grid.Row="1"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.HasAccounts, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountSyncStatusViewModel">
                                <toolkit:SettingsCard
                                    MinHeight="48"
                                    Padding="12,8,12,8"
                                    CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <toolkit:SettingsCard.Resources>
                                        <Thickness x:Key="SettingsCardHeaderIconMargin">2,0,12,0</Thickness>
                                        <x:Double x:Key="SettingsCardWrapThreshold">286</x:Double>
                                        <x:Double x:Key="SettingsCardContentMinWidth">0</x:Double>
                                        <x:Double x:Key="SettingsCardHeaderIconMaxSize">30</x:Double>
                                    </toolkit:SettingsCard.Resources>
                                    <toolkit:SettingsCard.Header>
                                        <TextBlock
                                            MaxWidth="286"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind AccountEmail, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                    </toolkit:SettingsCard.Header>
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <ImageIcon Source="{x:Bind helpers:BindingExtensions.ToImageSource(ProfilePictureUrl), Mode=OneTime}" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <toolkit:SettingsCard.Description>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ProgressBar
                                                Height="4"
                                                Margin="0,2,0,2"
                                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                Visibility="{x:Bind IsSyncing, Mode=OneWay}"
                                                Value="{x:Bind SyncProgress, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MinWidth="36"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind extensions:Utils.ToPerc(SyncProgress), Mode=OneWay}"
                                                Visibility="{x:Bind IsPercentageShown, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                MinWidth="36"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind DetailedSyncInfo, Mode=OneWay}" />
                                        </Grid>
                                    </toolkit:SettingsCard.Description>
                                    <Button
                                        x:Uid="StatusControl_SyncButton"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind StartSyncForAccountCommand}"
                                        Content="{ui:FontIcon Glyph=&#xE9F3;,
                                                              FontSize=14}"
                                        IsEnabled="{x:Bind helpers:BindingExtensions.Not(IsSyncing), Mode=OneWay}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind}" />
                                </toolkit:SettingsCard>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
